# ==============================================================================
# PaperFox Backend — Production & Development Environment Variables Template
# Copy to backend/.env and replace placeholders with your actual secure credentials.
# NEVER commit .env with real secrets to Git.
# ==============================================================================

# Core Application Settings
PROJECT_NAME=PaperFox
API_V1_STR=/api/v1
ENVIRONMENT=production

# Security & JWT Tokens (Generate 32+ random hex characters for each secret in production)
SECRET_KEY=generate_a_secure_random_32_character_secret_key_for_jwt_access
REFRESH_SECRET_KEY=generate_another_secure_random_32_character_secret_key_for_refresh
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SECURE_COOKIES=true

# Database Settings (MongoDB Atlas connection string)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=paperfox

# Production CORS Allowed Origins (Comma-separated or JSON array)
ALLOWED_ORIGINS=["https://paperfox.yourdomain.com","https://app.yourdomain.com","http://localhost:3000"]

# Rate Limiting Settings (In-memory sliding window)
RATE_LIMITING_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30

# LaTeX Document Engine Configuration
# LATEX_COMPILER — name (resolved via system PATH) or simple executable name.
# LATEX_COMPILER_PATH — optional: explicit full path to the pdflatex/xelatex binary.
#   Use this when LaTeX is installed but pdflatex is NOT on the backend process PATH.
#   Leave empty to rely on PATH resolution.
#
# Windows example (MiKTeX per-user install):
#   LATEX_COMPILER_PATH=C:\Users\yourname\AppData\Local\Programs\MiKTeX\miktex\bin\x64\pdflatex.exe
# Linux/macOS example (TeX Live):
#   LATEX_COMPILER_PATH=/usr/bin/pdflatex
# Docker (install texlive in Dockerfile, then leave PATH-based):
#   LATEX_COMPILER_PATH=
LATEX_COMPILER=pdflatex
LATEX_COMPILER_PATH=


# AI Provider Free-Tier Configuration (Server-Side Only — Never Expose to Frontend)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODEL=liquid/lfm-2.5-2.6b:free

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# AI Execution & Fallback Routing
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
JD_ANALYSIS_PRIMARY_PROVIDER=gemini
JD_ANALYSIS_FALLBACK_PROVIDERS=["groq","openrouter"]

