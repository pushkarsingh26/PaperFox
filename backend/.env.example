PROJECT_NAME=PaperFox
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_secret_key_in_production_32bytes_minimum
REFRESH_SECRET_KEY=change_this_to_another_secure_refresh_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=paperfox
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Providers Configuration
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_MODEL=gemini-1.5-flash

NVIDIA_API_KEY=your_nvidia_build_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

JD_ANALYSIS_PRIMARY_PROVIDER=gemini
JD_ANALYSIS_FALLBACK_PROVIDERS=["groq","openrouter","nvidia"]
